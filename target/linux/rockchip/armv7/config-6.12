# =============================================
# Rockchip ARMv7 Kernel Configuration (6.1)
# Optimized for RK3229 SoC and HK1Mini TV Box
# =============================================

# =====================
# General Setup
# =====================
CONFIG_LOCALVERSION="-immortalwrt"
CONFIG_DEFAULT_HOSTNAME="hk1mini"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
